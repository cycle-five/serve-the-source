{
  "name": "serve-the-source",
  "version": "0.1.0",
  "description": "Emit the Markdown source beside every rendered page, and serve it to agents that ask. Zero runtime dependencies.",
  "keywords": [
    "quartz",
    "quartz-plugin",
    "markdown",
    "static-site",
    "agents",
    "llm",
    "content-negotiation"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "quartz": {
    "type": "emitter",
    "entry": "ServeTheSource"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js && tsc --emitDeclarationOnly --declaration --outDir dist -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@quartz-community/types": ">=0.2"
  },
  "peerDependenciesMeta": {
    "@quartz-community/types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@quartz-community/types": "^0.3.0",
    "@types/node": "^24.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cycle-five/serve-the-source.git"
  }
}
